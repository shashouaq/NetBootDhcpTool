<Window x:Class="NetBootDhcpTool.App.AppDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="WidthAndHeight" MinWidth="430" MaxWidth="620" Background="#F7FAFD" FontFamily="Microsoft YaHei UI, Segoe UI">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C8D3E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="DialogRoot" Padding="22" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="14" Background="#F7FAFD" xmlns:help="clr-namespace:NetBootDhcpTool.App">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel>
        <Border x:Name="IconBadge" Width="38" Height="38" CornerRadius="19" Background="#E8F2FF" DockPanel.Dock="Left" Margin="0,0,12,0">
          <TextBlock x:Name="IconText" Text="!" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1769AA"/>
        </Border>
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="#162033" TextWrapping="Wrap"/>
      </DockPanel>
      <TextBox x:Name="MessageText" Grid.Row="1" Margin="50,12,0,18" FontSize="14" Foreground="#2F3B4C" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MaxHeight="520" VerticalScrollBarVisibility="Auto"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" help:HelpButtonService.HelpKey="help.dialog.cancel" Content="取消 / Cancel" MinWidth="108" Margin="6,0,0,0" Padding="12,6" Click="CancelButton_Click"/>
        <Button x:Name="OkButton" help:HelpButtonService.HelpKey="help.dialog.ok" Content="确定 / OK" MinWidth="108" Margin="6,0,0,0" Padding="12,6" FontWeight="SemiBold" Background="#1769AA" Foreground="White" Click="OkButton_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
