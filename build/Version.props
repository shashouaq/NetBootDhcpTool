<Project>
  <PropertyGroup>
    <!-- The only checked-in product version. Override Version only in isolated rehearsals. -->
    <Version Condition="'$(Version)' == ''">1.1.1</Version>
    <NetBootProductName>NetBoot DHCP Tool</NetBootProductName>
    <NetBootCompanyName>NetBootDhcpTool contributors</NetBootCompanyName>
    <NetBootCopyright>Copyright (c) NetBootDhcpTool contributors</NetBootCopyright>
  </PropertyGroup>
</Project>
